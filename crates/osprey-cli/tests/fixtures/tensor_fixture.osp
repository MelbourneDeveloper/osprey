// Reads transformer.safetensors beside this file; `@FIXTURE@` is replaced
// with the absolute path by tensor_fixture.rs before the program runs.
fn at(b, i) = gpuGet(b, i) ?: 0.0
fn four(b) = "${at(b, 0)} ${at(b, 1)} ${at(b, 2)} ${at(b, 3)}"
fn outcome(r) = match r {
    Success { value } => four(value)
    Error { message } => message
}
fn main() = {
    let w = gpuLoadTensor("@FIXTURE@", "w") ?: toGpu([0.0])
    let bias = gpuLoadTensor("@FIXTURE@", "h.1.b") ?: toGpu([0.0])
    let raw = gpuLoad("@FIXTURE@", 124, 4) ?: toGpu([0.0])
    let square = gpuMatMul(w, w, 2, 2, 2) ?: toGpu([0.0])
    print("w ${four(w)}\nbias ${at(bias, 0)} ${at(bias, 1)}\nmissing ${outcome(gpuLoadTensor("@FIXTURE@", "h.11.b"))}\nraw ${four(raw)}\nsquare ${four(square)}")
}
