namespace vigil;

// Implements [SECURITY-EVIDENCE]: exposure and review are not malware verdicts.
module Rules {
    fn exposure(area, signing, sandbox) = match area == "apps" && signing == "valid" && sandbox == "absent" {
        true => "sandbox-exposure"
        false => "information"
    }
    fn context(area, signing, sandbox, hidden, disabled) = match area {
        "startup" => match hidden { true => "hidden-startup" false => "information" }
        "protection" => match disabled { true => "protection-disabled" false => "information" }
        _ => exposure(area, signing, sandbox)
    }
    export fn classify(area, signing, sandbox, hidden, disabled) = match signing {
        "invalid" => "signature-review"
        "unverified" => "signature-review"
        _ => context(area, signing, sandbox, hidden, disabled)
    }
    export fn explanation(code) = match code {
        "signature-review" => "Static signature validation did not succeed. This does not establish malware; development builds, damage and changes need investigation."
        "sandbox-exposure" => "The validated signing metadata has no app-sandbox entitlement. This is exposure context; legitimate software can run outside the sandbox."
        "hidden-startup" => "A configured launch item points into a hidden path. Review its origin and purpose; developer tools also use hidden paths. Configuration does not prove execution."
        "protection-disabled" => "A protection command reported disabled. Confirm the setting and any authorized operational reason."
        _ => "Observed information only. Lack of a review item does not establish that the device is safe."
    }
    export fn source(code) = match code {
        "hidden-startup" => "https://attack.mitre.org/techniques/T1543/001/"
        "sandbox-exposure" => "https://developer.apple.com/documentation/security/app-sandbox"
        "signature-review" => "https://developer.apple.com/documentation/security/code-signing-services"
        "protection-disabled" => "https://support.apple.com/en-us/102149"
        _ => "https://csrc.nist.gov/pubs/sp/800/61/r3/final"
    }
}
