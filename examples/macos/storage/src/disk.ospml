// Implements [IOS-TARGET-MACOS]: Osprey owns the storage report. The host
// answers each question by asking macOS, so this module never touches the file
// system and its tests need no particular disk.
namespace storage

type Folder =
    path : string
    bytes : int

type Volume =
    total : int
    available : int
    important : int

type Listing =
    entries : List<Folder>
    blocked : int

type Survey =
    root : string
    volume : Volume
    measured : int
    unreadable : int
    folders : List<Folder>
    inside : List<Folder>

module Disk
    (** What the report asks the platform. The Mac handler answers from Foundation's volume keys and by measuring the tree, hidden files included; tests answer from fixed data. *)
    export effect Facts
        volume : string => Volume
        largest : string => Listing

    top count folders = match folders
        [] => []
        [first, ...rest] => match count > 0
            true => listPrepend (top (satSub count 1) rest) first
            false => []

    sumBytes folders = match folders
        [] => 0
        [first, ...rest] => satAdd first.bytes (sumBytes rest)

    insideLargest limit folders = match folders
        [] => []
        [largest, ..._rest] => top limit (perform Facts.largest largest.path).entries

    (** Ranks the entries under `root`, then asks for the entries inside the largest one. *)
    export survey root limit =
        listing = perform Facts.largest root
        folders = top limit listing.entries
        Survey(root = root, volume = perform Facts.volume root, measured = sumBytes listing.entries, unreadable = listing.blocked, folders = folders, inside = insideLargest limit folders)

    scaled tenths unit larger = match larger
        [] => shown tenths unit
        [next, ...rest] => match tenths >= 10000
            true => scaled (intDiv (satAdd tenths 500) 1000) next rest
            false => shown tenths unit

    shown tenths "B" = "${intDiv tenths 10} B"
    shown tenths unit = "${intDiv tenths 10}.${tenths % 10} ${unit}"

    (** Decimal units with one rounded decimal, as Finder and System Settings count them. *)
    export formatBytes bytes = match bytes < 0
        true => "unknown"
        false => scaled (satMul bytes 10) "B" ["KB", "MB", "GB", "TB"]

    (** The share of `whole`, rounded to a whole percent; an unknown or empty whole gives no share. *)
    export percent (part, whole) = match whole > 0
        false => 0
        true =>
            handle Arith
                overflow _ _ _ _ => 0
                remainderByZero _ => 0
            intDiv (satAdd (satMul part 100) (intDiv whole 2)) whole

    bar share = match share > 100
        true => bar 100
        false => (repeat "█" (intDiv share 5) ?: "") + (repeat "░" (satSub 20 (intDiv share 5)) ?: "")

    relative base path =
        prefix = match endsWith base "/"
            true => base
            false => base + "/"
        match startsWith path prefix
            true => drop path (length prefix)
            false => path

    line base whole folder =
        share = percent (folder.bytes, whole)
        size = padStart (formatBytes folder.bytes) 9 " " ?: ""
        "${size}  ${bar share} ${padStart (toString share) 3 " " ?: ""}%  ${relative base folder.path}"

    lines base whole folders = match folders
        [] => []
        [first, ...rest] => listPrepend (lines base whole rest) (line base whole first)

    section title base whole folders empty = match folders
        [] => "${title}\n  ${empty}"
        _ => join (listPrepend (lines base whole folders) title) "\n"

    volumeLine volume = match volume.total > 0
        false => "Volume capacity is unavailable for this path."
        true => "Volume: ${formatBytes volume.total} total, ${formatBytes (satSub volume.total volume.available)} used, ${formatBytes volume.available} free, ${formatBytes volume.important} available for important data."

    insideSection survey = match survey.folders
        [] => []
        [largest, ..._rest] => ["", section "Inside ${relative survey.root largest.path}" largest.path largest.bytes survey.inside "Nothing inside to rank: it is a file, or an empty or unreadable folder."]

    unreadableLines count = match count > 0
        false => []
        true => ["Folders that could not be read: ${count}. macOS protects them; grant the host Full Disk Access to count them."]

    (** The report text. Each share is of its section's measured total; the bar is twenty cells wide. *)
    export render survey =
        used = satSub survey.volume.total survey.volume.available
        header = [
            "Storage report for ${survey.root}",
            volumeLine survey.volume,
            "Measured ${formatBytes survey.measured} here, hidden files included (${percent (survey.measured, used)}% of used space).",
        ]
        ranking = ["", section "Largest items" survey.root survey.measured survey.folders "Nothing here could be measured: the folder is empty or unreadable."]
        join (listConcat (listConcat (listConcat header (unreadableLines survey.unreadable)) ranking) (insideSection survey)) "\n"
