// Implements [IOS-TARGET-MACOS]: the report logic runs natively under a fixed
// handler, so it is verified without Swift or a particular disk.
namespace storagetests

import storage::Disk

home = "/Users/ada"
library = "/Users/ada/Library"

folder path bytes = storage::Folder(path = path, bytes = bytes)

listing entries blocked = storage::Listing(entries = entries, blocked = blocked)

homeEntries () = [folder library 450000000000, folder "/Users/ada/.android" 120000000000, folder "/Users/ada/Downloads" 30000000000, folder "/Users/ada/notes.txt" 4096]

libraryEntries () = [folder "/Users/ada/Library/Developer" 300000000000, folder "/Users/ada/Library/Caches" 99500000000]

entriesFor path = match path
    "/Users/ada" => listing (homeEntries ()) 2
    "/Users/ada/Library" => listing (libraryEntries ()) 0
    _ => listing [] 0

ssd = storage::Volume(total = 1000000000000, available = 250000000000, important = 300000000000)

formatCase () =
    check "bytes" "999 B" (Disk::formatBytes 999)
    check "kilobytes" "1.0 KB" (Disk::formatBytes 1000)
    check "rounds across a unit" "1.0 MB" (Disk::formatBytes 999960)
    check "gigabytes" "4.1 GB" (Disk::formatBytes 4143181824)
    check "terabytes" "1.5 TB" (Disk::formatBytes 1500000000000)
    check "host failure" "unknown" (Disk::formatBytes (0 - 1))

shareCase () =
    check "share" 60 (Disk::percent (450, 750))
    check "empty whole" 0 (Disk::percent (1, 0))
    check "unknown whole" 0 (Disk::percent (5, 0 - 1))
    check "rounds half up" 38 (Disk::percent (3000000000000, 8000000000000))

surveyCase () =
    mut queries = ""
    recorded = handler Disk::Facts
        volume _ => ssd
        largest path =>
            queries := queries + path + ";"
            entriesFor path
    found = recorded (\() => Disk::survey home 2)
    check "one listing per level" "/Users/ada;/Users/ada/Library;" queries
    check "limited ranking" 2 (length found.folders)
    check "drills into the largest" 2 (length found.inside)
    check "measures every entry" 600000004096 found.measured
    check "keeps the root's unreadable count" 2 found.unreadable

reportCase () =
    fixture = handler Disk::Facts
        volume _ => ssd
        largest path => entriesFor path
    expected = join [
        "Storage report for /Users/ada",
        "Volume: 1.0 TB total, 750.0 GB used, 250.0 GB free, 300.0 GB available for important data.",
        "Measured 600.0 GB here, hidden files included (80% of used space).",
        "Folders that could not be read: 2. macOS protects them; grant the host Full Disk Access to count them.",
        "",
        "Largest items",
        " 450.0 GB  ███████████████░░░░░  75%  Library",
        " 120.0 GB  ████░░░░░░░░░░░░░░░░  20%  .android",
        "  30.0 GB  █░░░░░░░░░░░░░░░░░░░   5%  Downloads",
        "",
        "Inside Library",
        " 300.0 GB  █████████████░░░░░░░  67%  Developer",
        "  99.5 GB  ████░░░░░░░░░░░░░░░░  22%  Caches",
    ] "\n"
    check "report" expected (fixture (\() => Disk::render (Disk::survey home 3)))

emptyCase () =
    unreadable = handler Disk::Facts
        volume _ => storage::Volume(total = 0 - 1, available = 0 - 1, important = 0 - 1)
        largest _ => listing [] 0
    report = unreadable (\() => Disk::render (Disk::survey "/Volumes/Archive" 5))
    checkTrue "missing capacity" (contains report "Volume capacity is unavailable")
    checkTrue "nothing measured" (contains report "Nothing here could be measured")
    checkFalse "no unreadable line" (contains report "could not be read")
    checkFalse "no drill-down" (contains report "Inside")
    single = handler Disk::Facts
        volume _ => ssd
        largest path => match path
            "/Users/ada/Movies" => listing [folder "/Users/ada/Movies/trip.mov" 4143181824] 0
            _ => listing [] 0
    movies = single (\() => Disk::render (Disk::survey "/Users/ada/Movies" 5))
    checkTrue "a file has nothing inside" (contains movies "Inside trip.mov\n  Nothing inside to rank")

test "sizes use decimal units with one rounded decimal" formatCase
test "shares never divide by an unknown volume" shareCase
test "a survey drills into the largest entry only" surveyCase
test "hidden entries rank with the rest, and unreadable folders are reported" reportCase
test "missing data is reported, not invented" emptyCase
