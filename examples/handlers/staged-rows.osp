effect Read { value: fn() -> int }

fn relay(callback) !e = callback()
fn work() !Read = perform Read.value()

let precomputed = {
    handle static Read { value => 41 }
    relay(work)
}

let runtime = handler Read { value => 42 }
print("${precomputed} ${runtime(|| => relay(work))}")

static effect Signal<T> { read: fn() -> T }
type Count = { value: int }
type Cursor = { at: int }
fn count() = (perform Signal<Count>.read()).value
fn cursor() = (perform Signal<Cursor>.read()).at
fn counterView() = "counter=${count()}"
fn cursorView() = "cursor=${cursor()}"
fn statusView() = "${count()}/${cursor()}"
fn views(n, at) = {
    handle static Signal<Count> { read => Count { value: n } }
    handle static Signal<Cursor> { read => Cursor { at: at } }
    { counter: signalSnapshot(counterView), cursor: signalSnapshot(cursorView), status: signalSnapshot(statusView) }
}
fn refreshViews(old, changed, n, at) = {
    handle static Signal<Count> { read => Count { value: n } }
    handle static Signal<Cursor> { read => Cursor { at: at } }
    { counter: signalRefresh(old.counter, changed, counterView), cursor: signalRefresh(old.cursor, changed, cursorView), status: signalRefresh(old.status, changed, statusView) }
}
fn describe(frame) = "${frame.counter.value} ${frame.cursor.value} status=${frame.status.value} builds=${frame.counter.revision}/${frame.cursor.revision}/${frame.status.revision}"
let first = views(1, 2)
let next = refreshViews(first, signalDependencies(count), 7, 2)
let last = refreshViews(next, signalDependencies(cursor), 7, 4)
let idle = refreshViews(last, [], 7, 4)
print("${describe(next)}\n${describe(last)}\nidle=${idle.status.value} builds=${idle.status.revision}")
