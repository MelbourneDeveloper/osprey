// Greedy text generation with the trained GPT-2 model: no training from
// scratch, no conversion step, no Python. `make gpt2 PROMPT="..."` downloads the
// published weights into examples/gpt2/weights and runs this project. The prompt
// is the first line of stdin, the number of tokens to generate the optional
// second line (default 20). The model lives in ../model; this file is the
// sampler. The prompt takes one full forward pass; every later token takes one
// forwardStep over the blocks' cached qkv rows, so a token costs one position
// rather than the whole sequence, with every value the full pass would compute.
import gpt2::Tokenizer
import gpt2::Model
import gpt2::Model::{at, maxF, width, vocabSize, layerCount, endOfText}

let defaultPrompt = "The capital of France is"
let defaultTokens = 20

/// The most likely token after the last block's output row `last` [1, width]:
/// the tied output projection of its normalised state, then an argmax.
fn nextToken(w, last) = {
    let logits = Model::product(Model::layerNorm(last, 1, w.lnfG, w.lnfB), w.wteT, 1, width, vocabSize)
    let peak = logits |> gpuFold(at(logits, 0), maxF)
    gpuGet(gpuIota(vocabSize) |> gpuFilter(fn(v) => at(logits, v) == peak), 0) ?: endOfText
}

/// Row t - 1 of x [t, width].
fn lastRow(x, t) = gpuIota(width) |> gpuMap(fn(c) => at(x, (t - 1) * width + c))

/// `remaining` more tokens after ids, whose last token `pending` the cached
/// blocks have not seen yet.
fn generate(w, ids, caches, pending, remaining) = match remaining == 0 {
    true => ids
    false => {
        let step = Model::forwardStep(w, pending, listLength(ids), caches)
        let next = nextToken(w, step.x)
        match next == endOfText { true => ids  false => generate(w, listAppend(ids, next), step.caches, next, remaining - 1) }
    }
}

/// The prompt's continuation: the full pass's last row predicts the first
/// token, and the pass's qkv rows seed the caches for every later one.
fn continuation(w, ids, trace, t, count) = {
    let first = nextToken(w, lastRow(trace.x, t))
    match first == endOfText { true => ids  false => generate(w, listAppend(ids, first), Model::qkvCaches(trace), first, count - 1) }
}

fn main() = {
    handle Arith {
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    }
    let promptLine = input()
    let prompt = match promptLine == "" { true => defaultPrompt  false => promptLine }
    let count = parseInt(input()) ?: defaultTokens
    let bpe = Tokenizer::loadBpe(Model::weightsDir + "/merges.txt")
    let w = Model::loadWeights()
    let ids = Tokenizer::encode(bpe, prompt)
    let t = listLength(ids)
    print("gpt2 (124M) on ${gpuDevice()} — ${listLength(bpe.merges)} merges, ${intDiv(gpuLength(w.wte), width)} vocabulary rows, ${layerCount} layers")
    print("prompt: ${prompt}\ntokens:${Tokenizer::idsText(ids)}")
    let out = match count < 1 { true => ids  false => continuation(w, ids, Model::forward(w, toGpu(ids), t), t, count) }
    print("generated ${listLength(out) - listLength(ids)} tokens\n${Tokenizer::decode(bpe, out)}")
}
