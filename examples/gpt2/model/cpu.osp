// The CPU interpretation of `gpt2::Backends::Tensor`: every operation answered
// with host list code, accumulating in the same k order from 0.0 as
// examples/gpt2/reference.py. Nothing here names the GPU surface: weights load
// through the host `loadTensor` and a failed load aborts through the host
// runtime. Implements [STAGE-BACKEND], [BUILTIN-FILE-TENSOR].

namespace gpt2;

import gpt2::Backends::{Tensor, hit, minI}

module Cpu {
    extern fn osprey_tensor_panic(message: string) -> List<float>
    /// Broken-code quarantine: a failed load or product used to become an
    /// empty tensor, and the model generated from fabricated zeros. It aborts
    /// instead, through this handler's own runtime.
    fn orAbort(result) = match result {
        Success { value } => value
        Error { message } => osprey_tensor_panic(message)
    }

    /// Host lists, loaded straight into lists from the safetensors file.
    export fn onLists(work) = {
        handle static Tensor<List<float>> {
            build n f => range(0, n) |> map(f) |> toList()
            get b i => listGet(b, i) ?: 0.0
            length b => listLength(b)
            zipWith a b f => range(0, listLength(a)) |> map(fn(i) => f(listGet(a, i) ?: 0.0, listGet(b, i) ?: 0.0)) |> toList()
            reduce b seed f => range(0, listLength(b)) |> fold(seed, fn(a, i) => f(a, listGet(b, i) ?: 0.0))
            indexOf b x => range(0, listLength(b)) |> map(fn(i) => hit(listGet(b, i) ?: 0.0, x, i, listLength(b))) |> fold(listLength(b), minI)
            matMul a b rows inner cols => range(0, rows * cols) |> map(fn(i) => range(0, inner) |> fold(0.0, fn(acc, k) => acc + (listGet(a, intDiv(i, cols) * inner + k) ?: 0.0) * (listGet(b, k * cols + i % cols) ?: 0.0))) |> toList()
            fromList xs => xs
            load path name => orAbort(loadTensor(path, name))
            device => "lists"
        }
        work()
    }
}
