// GPT-2 on the Osprey GPU surface: the trained 124M-parameter model exactly as
// Hugging Face publishes it — `model.safetensors` and `merges.txt` from
// huggingface.co/openai-community/gpt2 — loaded with `gpuLoadTensor`, run as
// `gpu*` kernels and `gpuMatMul` products, and sampled greedily. No training,
// no conversion step, no Python: drop the published weights in and run.
//
// `make gpt2 PROMPT="..."` downloads the two files into examples/gpt2/weights
// and runs this program. The prompt is the first line of stdin, the number of
// tokens to generate the optional second line (default 20).
//
// This is plan 0023's reference application (docs/plans/0023-gpu-computation.md):
// one program that exercises [GPU-MATMUL], [GPU-BUFFER-TENSOR], [BUILTIN-MATH]
// and every combinator, on the host backend today and unchanged on a device
// backend tomorrow. Everything below runs on the CPU; `gpuDevice()` says so.

let weightsDir = "examples/gpt2/weights"
let defaultPrompt = "The capital of France is"
let defaultTokens = 20

// The GPT-2 small configuration (config.json in the same repository).
let vocabSize = 50257
let width = 768
let heads = 12
let headWidth = 64
let qkvWidth = 2304
let mlpWidth = 3072
let layerCount = 12
let endOfText = 50256
let epsilon = 0.00001
let widthF = 768.0
/// 1 / sqrt(headWidth), the attention score scale.
let scoreScale = 0.125
/// sqrt(2 / pi), the GELU tanh-approximation constant (gelu_new).
let geluScale = 0.7978845608028654
let geluCubic = 0.044715

// --- the byte-level BPE tokenizer ------------------------------------------
//
// GPT-2 tokenizes bytes, not characters. Each byte is first mapped to a
// printable stand-in code point so merges can be written as text; the 256
// stand-ins take ids 0..255 in `bytes_to_unicode` order, and merge number i of
// merges.txt produces token 256 + i. Decoding never needs vocab.json for that
// reason: the merge list IS the vocabulary.

/// A byte's stand-in code point: printable bytes stand for themselves, the
/// others take U+0100 onward in byte order.
fn byteToChar(b) = match b < 33 {
    true => 256 + b
    false => match b < 127 || (b > 160 && b != 173) {
        true => b
        false => match b == 173 { true => 323  false => 162 + b }
    }
}

/// The inverse of byteToChar.
fn charToByte(cp) = match cp < 256 {
    true => cp
    false => match cp < 289 { true => cp - 256  false => match cp == 323 { true => 173  false => cp - 162 } }
}

/// The vocabulary id of a single byte, in the order bytes_to_unicode lists them.
fn byteToId(b) = match b > 32 && b < 127 {
    true => b - 33
    false => match b > 160 && b < 173 {
        true => 94 + b - 161
        false => match b > 173 {
            true => 106 + b - 174
            false => match b < 33 { true => 188 + b  false => match b == 173 { true => 255  false => 221 + b - 127 } }
        }
    }
}

/// The byte a base vocabulary id (below 256) stands for.
fn idToByte(id) = match id < 94 {
    true => id + 33
    false => match id < 106 {
        true => 161 + id - 94
        false => match id < 188 {
            true => 174 + id - 106
            false => match id < 221 { true => id - 188  false => match id == 255 { true => 173  false => 127 + id - 221 } }
        }
    }
}

type Bpe = { merges: List<string>, ranks: Map<string, int>, ids: Map<string, int> }

/// The merge table from merges.txt: line i (after the version line) is the
/// pair "a b" with rank i - 1, producing token "ab" with id 255 + i.
fn loadBpe(path) = {
    let rows = lines(readFile(path) ?: "")
    let merges = range(1, listLength(rows)) |> fold(Bpe { merges: [], ranks: Map(), ids: Map() }, fn(acc, i) => {
        let pair = listGet(rows, i) ?: ""
        let token = replace(pair, " ", "") ?: pair
        Bpe { merges: listAppend(acc.merges, token), ranks: mapSet(acc.ranks, pair, i - 1), ids: mapSet(acc.ids, token, 255 + i) }
    })
    merges
}

/// Whether byte b is a letter: ASCII letters, and every non-ASCII byte, since
/// UTF-8 continuation bytes belong to the word they are inside.
fn isLetter(b) = (b > 64 && b < 91) || (b > 96 && b < 123) || b > 127
fn isDigit(b) = b > 47 && b < 58
fn isSpace(b) = b == 32 || b == 10 || b == 13 || b == 9

/// The character class a byte starts: 1 letters, 2 digits, 3 punctuation.
fn classOf(b) = match isLetter(b) { true => 1  false => match isDigit(b) { true => 2  false => 3 } }

fn byteOf(s, i) = byteAt(s, i) ?: 0
fn standIn(b) = fromCodePoint(byteToChar(b)) ?: ""

/// The length of a contraction suffix starting at i ('s 't 're 've 'm 'll 'd),
/// or 0 — these are their own pieces in GPT-2's pre-tokenizer.
fn contractionAt(s, i) = {
    let two = substring(s, i, i + 2) ?: ""
    let three = substring(s, i, i + 3) ?: ""
    match two == "'s" || two == "'t" || two == "'m" || two == "'d" {
        true => 2
        false => match three == "'re" || three == "'ve" || three == "'ll" { true => 3  false => 0 }
    }
}

type Scan = { pieces: List<string>, current: string, kind: int, spaces: string }

fn closePiece(sc) = match sc.current == "" { true => sc.pieces  false => listAppend(sc.pieces, sc.current) }

/// A whitespace run ends: every space but a trailing single ' ' is its own
/// piece, and that trailing space opens the next word (the regex's `\s+(?!\S)`).
fn flushSpaces(sc, nextIsWord) = match sc.spaces == "" {
    true => sc
    false => spacesEnd(sc, nextIsWord)
}

fn spacesEnd(sc, nextIsWord) = {
    let carry = match nextIsWord && endsWith(sc.spaces, "Ġ") { true => "Ġ"  false => "" }
    let standalone = substring(sc.spaces, 0, byteLength(sc.spaces) - byteLength(carry)) ?: ""
    let pieces = match standalone == "" { true => sc.pieces  false => listAppend(sc.pieces, standalone) }
    Scan { pieces: pieces, current: carry, kind: 0, spaces: "" }
}

/// Split the prompt into GPT-2's pre-tokenization pieces, as stand-in strings.
fn scanPieces(s, i, sc) = match i >= byteLength(s) {
    true => {
        let settled = flushSpaces(sc, false)
        closePiece(settled)
    }
    false => {
        let b = byteOf(s, i)
        let contraction = match b == 39 { true => contractionAt(s, i)  false => 0 }
        match isSpace(b) {
            true => scanPieces(s, i + 1, Scan { pieces: closePiece(sc), current: "", kind: 0, spaces: sc.spaces + standIn(b) })
            false => match contraction > 0 {
                true => scanPieces(s, i + contraction, Scan { pieces: listAppend(closePiece(flushSpaces(sc, false)), substring(s, i, i + contraction) ?: ""), current: "", kind: 0, spaces: "" })
                false => scanPieces(s, i + 1, extend(flushSpaces(sc, true), b))
            }
        }
    }
}

/// Append byte b to the open piece, or start a new piece when its class changes.
fn extend(sc, b) = {
    let kind = classOf(b)
    let continues = sc.kind == kind || (sc.kind == 0 && sc.current != "")
    match continues {
        true => Scan { pieces: sc.pieces, current: sc.current + standIn(b), kind: kind, spaces: "" }
        false => Scan { pieces: closePiece(sc), current: standIn(b), kind: kind, spaces: "" }
    }
}

/// The stand-in characters of a piece, one string each.
fn symbolsOf(piece, i, acc) = match i >= byteLength(piece) {
    true => acc
    false => {
        let cp = codePointAt(piece, i) ?: 63
        symbolsOf(piece, i + (codePointWidth(cp) ?: 1), listAppend(acc, fromCodePoint(cp) ?: "?"))
    }
}

fn symbolAt(syms, i) = listGet(syms, i) ?: ""

type Best = { rank: int, at: int }

/// The adjacent pair with the lowest merge rank, or at == -1 when none merges.
fn bestPair(bpe, syms) = range(0, listLength(syms) - 1) |> fold(Best { rank: 2147483647, at: 0 - 1 }, fn(best, i) => {
    let rank = mapGet(bpe.ranks, symbolAt(syms, i) + " " + symbolAt(syms, i + 1)) ?: 2147483647
    match rank < best.rank { true => Best { rank: rank, at: i }  false => best }
})

/// Merge every non-overlapping occurrence of (first, second), left to right.
fn mergeAll(syms, first, second, i, acc) = match i >= listLength(syms) {
    true => acc
    false => {
        let s = symbolAt(syms, i)
        match s == first && i + 1 < listLength(syms) && symbolAt(syms, i + 1) == second {
            true => mergeAll(syms, first, second, i + 2, listAppend(acc, s + second))
            false => mergeAll(syms, first, second, i + 1, listAppend(acc, s))
        }
    }
}

/// Byte-pair encode one piece: merge the best-ranked pair until none remains.
fn bpeEncode(bpe, syms) = {
    let best = bestPair(bpe, syms)
    match best.at < 0 {
        true => syms
        false => bpeEncode(bpe, mergeAll(syms, symbolAt(syms, best.at), symbolAt(syms, best.at + 1), 0, []))
    }
}

/// A symbol's vocabulary id: a lone stand-in is a base byte, anything longer a merge.
fn idOf(bpe, sym) = match mapGet(bpe.ids, sym) {
    Success { value } => value
    Error _ => byteToId(charToByte(codePointAt(sym, 0) ?: 63))
}

fn encodePiece(bpe, piece) = bpeEncode(bpe, symbolsOf(piece, 0, [])) |> fn(syms) => range(0, listLength(syms)) |> fold([], fn(acc, i) => listAppend(acc, idOf(bpe, symbolAt(syms, i))))

/// The token ids of a prompt.
fn encode(bpe, text) = {
    let pieces = scanPieces(text, 0, Scan { pieces: [], current: "", kind: 0, spaces: "" })
    range(0, listLength(pieces)) |> fold([], fn(acc, i) => listConcat(acc, encodePiece(bpe, listGet(pieces, i) ?: "")))
}

/// The bytes a token id stands for, appended to acc.
fn bytesOfToken(bpe, id, acc) = match id < 256 {
    true => listAppend(acc, idToByte(id))
    false => {
        let token = listGet(bpe.merges, id - 256) ?: ""
        let syms = symbolsOf(token, 0, [])
        range(0, listLength(syms)) |> fold(acc, fn(bytes, i) => listAppend(bytes, charToByte(codePointAt(symbolAt(syms, i), 0) ?: 63)))
    }
}

/// Decode UTF-8 bytes into text; a malformed sequence prints as '?'.
fn textOf(bytes, i, acc) = match i >= listLength(bytes) {
    true => acc
    false => {
        let b = listGet(bytes, i) ?: 63
        let n = match b < 128 { true => 1  false => match b < 224 { true => 2  false => match b < 240 { true => 3  false => 4 } } }
        let lead = match n == 1 { true => b  false => match n == 2 { true => b - 192  false => match n == 3 { true => b - 224  false => b - 240 } } }
        let cp = range(1, n) |> fold(lead, fn(acc, k) => acc * 64 + (listGet(bytes, i + k) ?: 128) - 128)
        textOf(bytes, i + n, acc + (fromCodePoint(cp) ?: "?"))
    }
}

fn decode(bpe, ids) = {
    let bytes = range(0, listLength(ids)) |> fold([], fn(acc, i) => bytesOfToken(bpe, listGet(ids, i) ?: 0, acc))
    textOf(bytes, 0, "")
}

// --- the transformer ------------------------------------------------------------

type Layer = {
    ln1g: GpuBuffer<float>, ln1b: GpuBuffer<float>,
    qkvW: GpuBuffer<float>, qkvB: GpuBuffer<float>,
    projW: GpuBuffer<float>, projB: GpuBuffer<float>,
    ln2g: GpuBuffer<float>, ln2b: GpuBuffer<float>,
    fcW: GpuBuffer<float>, fcB: GpuBuffer<float>,
    outW: GpuBuffer<float>, outB: GpuBuffer<float>
}

type Weights = {
    wte: GpuBuffer<float>, wteT: GpuBuffer<float>, wpe: GpuBuffer<float>,
    lnfG: GpuBuffer<float>, lnfB: GpuBuffer<float>, blocks: List<Layer>
}

fn at(m, i) = gpuGet(m, i) ?: 0.0
fn addF(a, x) = a + x
fn maxF(a, x) = match x > a { true => x  false => a }
fn gelu(x) = 0.5 * x * (1.0 + tanh(geluScale * (x + geluCubic * x * x * x)))

/// One tensor of the checkpoint. A missing or mis-typed tensor is reported and
/// yields an empty buffer, which the first product refuses by name.
fn tensor(name) = match gpuLoadTensor(weightsDir + "/model.safetensors", name) {
    Success { value } => value
    Error { message } => {
        print(message)
        toGpu([])
    }
}

fn layerAt(i) = {
    let p = "h.${i}."
    Layer {
        ln1g: tensor(p + "ln_1.weight"), ln1b: tensor(p + "ln_1.bias"),
        qkvW: tensor(p + "attn.c_attn.weight"), qkvB: tensor(p + "attn.c_attn.bias"),
        projW: tensor(p + "attn.c_proj.weight"), projB: tensor(p + "attn.c_proj.bias"),
        ln2g: tensor(p + "ln_2.weight"), ln2b: tensor(p + "ln_2.bias"),
        fcW: tensor(p + "mlp.c_fc.weight"), fcB: tensor(p + "mlp.c_fc.bias"),
        outW: tensor(p + "mlp.c_proj.weight"), outB: tensor(p + "mlp.c_proj.bias")
    }
}

/// The token embedding transposed to [width, vocab], so the tied output
/// projection is one product instead of fifty thousand gathers per step.
fn transposed(wte) = gpuIota(width * vocabSize) |> gpuMap(fn(i) => at(wte, (i % vocabSize) * width + intDiv(i, vocabSize)))

fn loadWeights() = {
    let wte = tensor("wte.weight")
    Weights {
        wte: wte, wteT: transposed(wte), wpe: tensor("wpe.weight"),
        lnfG: tensor("ln_f.weight"), lnfB: tensor("ln_f.bias"),
        blocks: range(0, layerCount) |> fold([], fn(acc, i) => listAppend(acc, layerAt(i)))
    }
}

/// Sum of a contiguous run of a flat buffer.
fn sumRange(x, start, n) = range(start, start + n) |> fold(0.0, fn(a, i) => a + at(x, i))
fn squaredDeviation(x, start, n, mean) = range(start, start + n) |> fold(0.0, fn(a, i) => a + (at(x, i) - mean) * (at(x, i) - mean))

/// LayerNorm over each of the t rows of x [t, width].
fn layerNorm(x, t, g, b) = {
    let means = gpuIota(t) |> gpuMap(fn(r) => sumRange(x, r * width, width) / widthF)
    let variances = gpuIota(t) |> gpuMap(fn(r) => squaredDeviation(x, r * width, width, at(means, r)) / widthF)
    gpuIota(t * width) |> gpuMap(fn(i) => {
        let r = intDiv(i, width)
        let c = i % width
        (at(x, i) - at(means, r)) / sqrt(at(variances, r) + epsilon) * at(g, c) + at(b, c)
    })
}

/// x [rows, inner] times w [inner, cols], plus the bias on every row.
fn linear(x, rows, inner, cols, w, bias) = match gpuMatMul(x, w, rows, inner, cols) {
    Success { value } => gpuIota(rows * cols) |> gpuMap(fn(i) => at(value, i) + at(bias, i % cols))
    Error { message } => {
        print(message)
        toGpu([])
    }
}

/// qkv is [t, 2304]: the query, key and value of head h occupy 64 columns each.
fn qAt(qkv, r, h, d) = at(qkv, r * qkvWidth + h * headWidth + d)
fn kAt(qkv, r, h, d) = at(qkv, r * qkvWidth + width + h * headWidth + d)
fn vAt(qkv, r, h, d) = at(qkv, r * qkvWidth + 2 * width + h * headWidth + d)
fn score(qkv, h, r, c) = (range(0, headWidth) |> fold(0.0, fn(a, d) => a + qAt(qkv, r, h, d) * kAt(qkv, c, h, d))) * scoreScale
fn rowMax(scores, row, t, r) = range(0, r + 1) |> fold(at(scores, row * t), fn(a, c) => maxF(a, at(scores, row * t + c)))
fn weighted(probs, qkv, t, r, h, d) = range(0, r + 1) |> fold(0.0, fn(a, c) => a + at(probs, (h * t + r) * t + c) * vAt(qkv, c, h, d))

/// Causal multi-head self-attention over qkv [t, 2304], as [t, width].
/// Scores, weights and probabilities are [heads, t, t]; row (h, r) attends to
/// columns c <= r only.
fn attention(qkv, t) = {
    let scores = gpuIota(heads * t * t) |> gpuMap(fn(i) => {
        let h = intDiv(i, t * t)
        let r = intDiv(i % (t * t), t)
        let c = i % t
        match c <= r { true => score(qkv, h, r, c)  false => 0.0 }
    })
    let peaks = gpuIota(heads * t) |> gpuMap(fn(row) => rowMax(scores, row, t, row % t))
    let weights = gpuIota(heads * t * t) |> gpuMap(fn(i) => {
        let row = intDiv(i, t)
        match i % t <= row % t { true => exp(at(scores, i) - at(peaks, row))  false => 0.0 }
    })
    let sums = gpuIota(heads * t) |> gpuMap(fn(row) => sumRange(weights, row * t, t))
    let probs = gpuIota(heads * t * t) |> gpuMap(fn(i) => at(weights, i) / at(sums, intDiv(i, t)))
    gpuIota(t * width) |> gpuMap(fn(i) => {
        let r = intDiv(i, width)
        let h = intDiv(i % width, headWidth)
        weighted(probs, qkv, t, r, h, i % headWidth)
    })
}

/// One transformer block: pre-norm attention and MLP, each with a residual.
fn block(x, t, l) = {
    let qkv = linear(layerNorm(x, t, l.ln1g, l.ln1b), t, width, qkvWidth, l.qkvW, l.qkvB)
    let x2 = gpuZipWith(x, linear(attention(qkv, t), t, width, width, l.projW, l.projB), addF)
    let hidden = linear(layerNorm(x2, t, l.ln2g, l.ln2b), t, width, mlpWidth, l.fcW, l.fcB) |> gpuMap(gelu)
    gpuZipWith(x2, linear(hidden, t, mlpWidth, width, l.outW, l.outB), addF)
}

fn blocks(w, x, t, i) = match i == layerCount {
    true => x
    false => blocks(w, block(x, t, listGet(w.blocks, i) ?: emptyLayer()), t, i + 1)
}

fn emptyLayer() = {
    let e = toGpu([])
    Layer { ln1g: e, ln1b: e, qkvW: e, qkvB: e, projW: e, projB: e, ln2g: e, ln2b: e, fcW: e, fcB: e, outW: e, outB: e }
}

/// Token plus position embeddings, [t, width].
fn embed(w, tokens, t) = gpuIota(t * width) |> gpuMap(fn(i) => {
    let r = intDiv(i, width)
    at(w.wte, (gpuGet(tokens, r) ?: 0) * width + i % width) + at(w.wpe, i)
})

/// The most likely next token after the sequence: the tied output projection
/// of the final position's normalised state, then an argmax.
fn nextToken(w, ids) = {
    let t = listLength(ids)
    let tokens = toGpu(ids)
    let x = layerNorm(blocks(w, embed(w, tokens, t), t, 0), t, w.lnfG, w.lnfB)
    let last = gpuIota(width) |> gpuMap(fn(c) => at(x, (t - 1) * width + c))
    let logits = linear(last, 1, width, vocabSize, w.wteT, toGpu([0.0]))
    let peak = logits |> gpuFold(at(logits, 0), maxF)
    gpuGet(gpuIota(vocabSize) |> gpuFilter(fn(v) => at(logits, v) == peak), 0) ?: endOfText
}

fn idsText(ids) = range(0, listLength(ids)) |> fold("", fn(acc, i) => acc + " " + toString(listGet(ids, i) ?: 0))

fn generate(w, ids, remaining) = match remaining == 0 {
    true => ids
    false => {
        let next = nextToken(w, ids)
        match next == endOfText { true => ids  false => generate(w, listAppend(ids, next), remaining - 1) }
    }
}

fn main() = {
    handle Arith {
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    }
    let promptLine = input()
    let prompt = match promptLine == "" { true => defaultPrompt  false => promptLine }
    let count = parseInt(input()) ?: defaultTokens
    let bpe = loadBpe(weightsDir + "/merges.txt")
    let w = loadWeights()
    let ids = encode(bpe, prompt)
    print("gpt2 (124M) on ${gpuDevice()} — ${listLength(bpe.merges)} merges, ${intDiv(gpuLength(w.wte), width)} vocabulary rows, ${layerCount} layers")
    print("prompt: ${prompt}\ntokens:${idsText(ids)}")
    let out = generate(w, ids, count)
    print("generated ${listLength(out) - listLength(ids)} tokens\n${decode(bpe, out)}")
}
