// The scalar C boundary both mobile targets must honour, exercised by
// scripts/mobile-abi.c on a real iPhone/simulator link and on Android.
// Implements [IOS-HOST-ABI] [IOS-TARGET-ENTRY] [ANDROID-HOST-ABI].
//
// Every export here exists to pin one property of the boundary the header
// cannot state: the width and sign of an integer, that a double survives
// round-tripping, that a C bool arrives canonical under both bool ABIs, that
// a UTF-8 string crosses intact in both directions, that Osprey copies a
// borrowed host string instead of aliasing it, and that an opaque host handle
// comes back unchanged.

extern fn hostRecord(value: int, ready: bool, label: string) -> Unit
extern fn hostNegate(value: bool) -> bool
extern fn hostMeasure(text: string) -> int
extern fn hostResolve(window: Ptr) -> int

let seed = "persisted ${41}"

fn stored() = seed
fn greet(name: string) = "Hello ${name}"
fn invert(value) = !value
fn invertViaHost(value) = hostNegate(value)
fn both(left, right) = left && right
fn big() = 9223372036854775807
fn small() = 0 - 9223372036854775807 - 1
fn overflowDefault() = {
    handle Arith { overflow _ _ _ _ => -1 }
    big() + 1
}
fn negate(value) = wrapSub(0, value)
fn scale(value: float) = value * 1.5
fn half(value: float) -> float = value / 2.0

/// `length`, string interpolation and `/` are polymorphic, so these three
/// annotations are what resolve the signatures the C boundary can carry. A
/// function left generic is inlined at its call sites, has no symbol, and is
/// therefore absent from the header — the boundary reports what codegen
/// emitted, never what a caller hoped for. [IOS-HOST-ABI]
fn spanOf(text: string) -> int = length(text)
fn bytes(text) = byteLength(text)
fn upper(text) = toUpperCase(text)
fn joinWith(left: string, right: string) -> string = "${left}|${right}"

/// An Osprey-allocated string crossing into C, rather than a literal.
fn measured(text) = hostMeasure(toUpperCase(text))

fn emit(value, ready, label) = hostRecord(value, ready, label)

/// A host handle held and returned without being inspected [FFI-PTR]. Identity
/// is polymorphic, so the annotation is what gives it a C symbol.
fn passBack(window: Ptr) = window
fn resolve(window) = hostResolve(window)

hostRecord(41, true, "boot")
