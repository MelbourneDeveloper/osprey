namespace registry;
import registry::TomlLexer

/// A typed parser for the TOML v1.0.0 subset Osprey manifests use: comments,
/// blank lines, bare and basic-quoted keys, dotted keys, `[table]` and
/// `[[array-of-tables]]` headers, basic and literal strings, decimal integers,
/// booleans, arrays and inline tables. The result is a nested `Table` whose
/// pairs keep document order and whose leaves carry 1-based byte spans.
/// Failures are `code at line:column` strings, never prose.
/// Implements [PACKAGE-MANIFEST].
module Toml {
    export type Span = { line: int, column: int }
    export type Problem = { code: string, line: int, column: int }
    export type Pair = { key: string, value: Value, span: Span }
    export type Value = Str { text: string } | Int { value: int } | Bool { flag: bool } | Arr { items: List<Value> } | Table { pairs: List<Pair> }

    type KeySeg = { name: string, span: Span }
    type Focus = { keys: List<string>, index: int }
    type Doc = { root: Value, focus: Focus }
    type Step = { doc: Doc, at: TomlLexer::Cursor }
    type Val = { value: Value, at: TomlLexer::Cursor }
    type Path = { segs: List<KeySeg>, at: TomlLexer::Cursor }
    type KS = { seg: KeySeg, at: TomlLexer::Cursor }
    type KeyScan = { name: string, at: TomlLexer::Cursor }
    type ArrDef = { root: Value, index: int }

    let byteQuote = 34
    let byteApostrophe = 39
    let byteHash = 35
    let byteComma = 44
    let byteDot = 46
    let byteEq = 61
    let byteLBracket = 91
    let byteRBracket = 93
    let byteLBrace = 123
    let byteRBrace = 125
    let bytePlus = 43
    let byteMinus = 45
    let byteUnderscore = 95
    let byteNewline = 10
    let byteCr = 13
    let byteTab = 9
    let byteSpace = 32
    let noIndex = -1
    let letterT = 116
    let letterF = 102

    let emptyTable = Table { pairs: [] }
    let missingPair = Pair { key: "", value: Table { pairs: [] }, span: Span { line: 0, column: 0 } }
    let missingKeySeg = KeySeg { name: "", span: Span { line: 0, column: 0 } }

    fn isDigit(b) = b >= 48 && b <= 57
    fn isDigit1to9(b) = b >= 49 && b <= 57
    fn isLower(b) = b >= 97 && b <= 122
    fn isUpper(b) = b >= 65 && b <= 90
    fn isBareKeyByte(b) = isLower(b) || isUpper(b) || isDigit(b) || b == byteUnderscore || b == byteMinus
    fn keyEndByte(b) = b == byteDot || b == byteEq || b == byteRBracket || b == byteSpace || b == byteTab || b == byteCr || b == byteNewline || b == -1

    fn fail(c, code) = describe(Problem { code: code, line: c.line, column: c.column })
    fn failSpan(span, code) = describe(Problem { code: code, line: span.line, column: span.column })
    fn spanOf(c) = Span { line: c.line, column: c.column }

    fn hasByte(s, b) = fold(range(0, byteLength(s)), false, fn(found, i) => found || (byteAt(s, i) ?: -1) == b)
    fn hasMinusAfterStart(s) = fold(range(1, byteLength(s)), false, fn(found, i) => found || (byteAt(s, i) ?: -1) == byteMinus)
    fn stripUnderscores(s) = join(split(s, "_") ?: [s], "")

    // -- tree navigation ----------------------------------------------------

    fn pairAt(pairs, i) = listGet(pairs, i) ?: missingPair

    fn findPair(pairs, key) = fold(range(0, length(pairs)), -1, fn(acc, i) => if acc == -1 && pairAt(pairs, i).key == key { i } else { acc })

    fn childOfKey(v, key) = match v {
        Table { pairs } => pairAt(pairs, findPair(pairs, key)).value
        _ => emptyTable
    }

    fn setPair(pairs, key, newValue) = match findPair(pairs, key) >= 0 {
        true => range(0, length(pairs)) |> map(fn(i) => if pairAt(pairs, i).key == key { Pair { key: key, value: newValue, span: pairAt(pairs, i).span } } else { pairAt(pairs, i) }) |> toList
        false => listAppend(pairs, Pair { key: key, value: newValue, span: Span { line: 0, column: 0 } })
    }

    fn setChildKey(v, key, newChild) = match v {
        Table { pairs } => Table { pairs: setPair(pairs, key, newChild) }
        _ => v
    }

    fn replaceAt(items, index, item) = range(0, length(items)) |> map(fn(i) => if i == index { item } else { listGet(items, i) ?: item }) |> toList

    fn init(keys) = range(0, length(keys) - 1) |> map(fn(i) => listGet(keys, i) ?: "") |> toList
    fn lastKey(keys) = listGet(keys, length(keys) - 1) ?: ""

    fn tableAt(root, keys) = foldList(keys, root, fn(acc, key) => childOfKey(acc, key))

    fn arrItemAt(root, keys, index) = {
        let parent = tableAt(root, init(keys))
        match childOfKey(parent, lastKey(keys)) {
            Arr { items } => listGet(items, index) ?: emptyTable
            _ => emptyTable
        }
    }

    fn setTableAt(root, keys, table) = match isEmpty(keys) {
        true => table
        false => {
            let key = listGet(keys, 0) ?: ""
            setChildKey(root, key, setTableAt(childOfKey(root, key), range(1, length(keys)) |> map(fn(i) => listGet(keys, i) ?: "") |> toList, table))
        }
    }

    fn setArrItemAt(root, keys, index, table) = {
        let parent = tableAt(root, init(keys))
        let arr = childOfKey(parent, lastKey(keys))
        let newArr = match arr {
            Arr { items } => Arr { items: replaceAt(items, index, table) }
            _ => arr
        }
        setTableAt(root, init(keys), setChildKey(parent, lastKey(keys), newArr))
    }

    fn getFocus(root, focus) = match focus.index == noIndex {
        true => tableAt(root, focus.keys)
        false => arrItemAt(root, focus.keys, focus.index)
    }

    fn setFocus(root, focus, table) = match focus.index == noIndex {
        true => setTableAt(root, focus.keys, table)
        false => setArrItemAt(root, focus.keys, focus.index, table)
    }

    // -- key-path insertion -------------------------------------------------

    // Recursive through insertNested/insertDeep: codegen needs the return type spelled out.
    fn insertInto(table, segs, val) -> Result<Value, string> = match length(segs) == 1 {
        true => insertLeaf(table, listGet(segs, 0) ?: missingKeySeg, val)
        false => insertNested(table, segs, val)
    }

    fn insertNested(table, segs, val) = {
        let seg = listGet(segs, 0) ?: missingKeySeg
        match childOrCreate(table, seg) {
            Error { message } => Error { message: message }
            Success { value } => insertDeep(table, seg, segs, value, val)
        }
    }

    fn insertDeep(table, seg, segs, child, val) = match insertInto(child, dropSeg(segs), val) {
        Success { value } => Success { value: setChildKey(table, seg.name, value) }
        Error { message } => Error { message: message }
    }

    fn insertLeaf(table, seg, val) = match table {
        Table { pairs } => match findPair(pairs, seg.name) >= 0 {
            true => Error { message: failSpan(seg.span, "toml.duplicate-key") }
            false => Success { value: Table { pairs: listAppend(pairs, Pair { key: seg.name, value: val, span: seg.span }) } }
        }
        _ => Error { message: failSpan(seg.span, "toml.not-a-table") }
    }

    fn childOrCreate(table, seg) = match table {
        Table { pairs } => match findPair(pairs, seg.name) >= 0 {
            true => childOrExisting(pairs, findPair(pairs, seg.name), seg)
            false => Success { value: emptyTable }
        }
        _ => Error { message: failSpan(seg.span, "toml.not-a-table") }
    }

    fn childOrExisting(pairs, i, seg) = match pairAt(pairs, i).value {
        Table => Success { value: pairAt(pairs, i).value }
        _ => Error { message: failSpan(seg.span, "toml.not-a-table") }
    }

    fn dropSeg(segs) = range(1, length(segs)) |> map(fn(i) => listGet(segs, i) ?: missingKeySeg) |> toList

    fn defineTable(root, segs) = match length(segs) == 1 {
        true => defineLeaf(root, listGet(segs, 0) ?: missingKeySeg)
        false => defineNested(root, segs)
    }

    fn defineNested(root, segs) = {
        let seg = listGet(segs, 0) ?: missingKeySeg
        match childOrCreate(root, seg) {
            Error { message } => Error { message: message }
            Success { value } => defineDeep(root, seg, segs, value)
        }
    }

    fn defineDeep(root, seg, segs, child) = match defineTable(child, dropSeg(segs)) {
        Success { value } => Success { value: setChildKey(root, seg.name, value) }
        Error { message } => Error { message: message }
    }

    fn defineLeaf(root, seg) = match root {
        Table { pairs } => match findPair(pairs, seg.name) >= 0 {
            true => defineExisting(pairs, findPair(pairs, seg.name), seg)
            false => Success { value: Table { pairs: listAppend(pairs, Pair { key: seg.name, value: emptyTable, span: seg.span }) } }
        }
        _ => Error { message: failSpan(seg.span, "toml.not-a-table") }
    }

    fn defineExisting(pairs, i, seg) = match pairAt(pairs, i).value {
        Table => Error { message: failSpan(seg.span, "toml.duplicate-key") }
        _ => Error { message: failSpan(seg.span, "toml.not-a-table") }
    }

    fn defineArrayTable(root, segs) = match length(segs) == 1 {
        true => appendArrayLeaf(root, listGet(segs, 0) ?: missingKeySeg)
        false => defineArrayNested(root, segs)
    }

    fn defineArrayNested(root, segs) = {
        let seg = listGet(segs, 0) ?: missingKeySeg
        match childOrCreate(root, seg) {
            Error { message } => Error { message: message }
            Success { value } => defineArrayDeep(root, seg, segs, value)
        }
    }

    fn defineArrayDeep(root, seg, segs, child) = match defineArrayTable(child, dropSeg(segs)) {
        Success { value } => Success { value: ArrDef { root: setChildKey(root, seg.name, value.root), index: value.index } }
        Error { message } => Error { message: message }
    }

    fn appendArrayLeaf(root, seg) = match root {
        Table { pairs } => match findPair(pairs, seg.name) >= 0 {
            true => appendExisting(pairs, findPair(pairs, seg.name), seg)
            false => Success { value: ArrDef { root: Table { pairs: listAppend(pairs, Pair { key: seg.name, value: Arr { items: [emptyTable] }, span: seg.span }) }, index: 0 } }
        }
        _ => Error { message: failSpan(seg.span, "toml.not-a-table") }
    }

    fn appendExisting(pairs, i, seg) = match pairAt(pairs, i).value {
        Arr { items } => Success { value: ArrDef { root: Table { pairs: setPair(pairs, seg.name, Arr { items: listAppend(items, emptyTable) }) }, index: length(items) } }
        _ => Error { message: failSpan(seg.span, "toml.not-a-table") }
    }

    fn insertAtFocus(doc, segs, val) = {
        let current = getFocus(doc.root, doc.focus)
        match insertInto(current, segs, val) {
            Success { value } => Success { value: Doc { root: setFocus(doc.root, doc.focus, value), focus: doc.focus } }
            Error { message } => Error { message: message }
        }
    }

    // -- keys ---------------------------------------------------------------

    fn scanBareKey(c) = scanBareKeyUpTo(c, "")
    fn scanBareKeyUpTo(c, acc) = match isBareKeyByte(TomlLexer::cur(c)) {
        true => scanBareKeyUpTo(TomlLexer::advance(c), acc + (substring(c.text, c.at, c.at + 1) ?: ""))
        false => KeyScan { name: acc, at: c }
    }

    fn parseKeySeg(c) = match TomlLexer::cur(c) == byteQuote {
        true => parseQuotedKey(c)
        false => match TomlLexer::cur(c) >= 128 {
            true => Error { message: fail(c, "toml.non-ascii") }
            false => match isBareKeyByte(TomlLexer::cur(c)) {
                true => parseBareKey(c)
                false => match keyEndByte(TomlLexer::cur(c)) {
                    true => Error { message: fail(c, "toml.empty-key") }
                    false => Error { message: fail(c, "toml.bad-key") }
                }
            }
        }
    }

    fn parseQuotedKey(c) = match TomlLexer::basicString(c) {
        Error { message } => Error { message: message }
        Success { value } => match byteLength(value.text) == 0 {
            true => Error { message: fail(c, "toml.empty-key") }
            false => Success { value: KS { seg: KeySeg { name: value.text, span: spanOf(c) }, at: value.at } }
        }
    }

    fn parseBareKey(c) = {
        let s = scanBareKey(c)
        match byteLength(s.name) == 0 {
            true => Error { message: fail(c, "toml.empty-key") }
            false => match TomlLexer::cur(s.at) >= 128 {
                true => Error { message: fail(s.at, "toml.non-ascii") }
                false => match keyEndByte(TomlLexer::cur(s.at)) {
                    true => Success { value: KS { seg: KeySeg { name: s.name, span: spanOf(c) }, at: s.at } }
                    false => Error { message: fail(s.at, "toml.bad-key") }
                }
            }
        }
    }

    fn parseKeyPath(c) = match parseKeySeg(c) {
        Error { message } => Error { message: message }
        Success { value } => keyPathTail(value.at, [value.seg])
    }

    fn keyPathTail(c, segs) = match TomlLexer::cur(c) == byteDot {
        false => Success { value: Path { segs: segs, at: c } }
        true => match parseKeySeg(TomlLexer::advance(c)) {
            Error { message } => Error { message: message }
            Success { value } => keyPathTail(value.at, listAppend(segs, value.seg))
        }
    }

    // -- values -------------------------------------------------------------

    fn missingValueAt(c) = TomlLexer::cur(c) == byteNewline || TomlLexer::cur(c) == byteCr || TomlLexer::cur(c) == byteHash || TomlLexer::cur(c) == byteComma || TomlLexer::cur(c) == byteRBracket || TomlLexer::cur(c) == byteRBrace || TomlLexer::eof(c)

    // Recursive through arrays and inline tables: codegen needs the return type spelled out.
    fn parseValue(c) -> Result<Val, string> = {
        let b = TomlLexer::cur(c)
        if b == byteQuote { parseBasicValue(c) }
        else if b == byteApostrophe { parseLiteralValue(c) }
        else if b == byteLBracket { parseArray(c) }
        else if b == byteLBrace { parseInlineTable(c) }
        else if b == letterT { parseWord(c, "true", true) }
        else if b == letterF { parseWord(c, "false", false) }
        else { parseBareValue(c) }
    }

    fn parseWord(c, word, flag) = match TomlLexer::scanBare(c) {
        Error { message } => Error { message: message }
        Success { value } => match value.token == word {
            true => Success { value: Val { value: Bool { flag: flag }, at: value.at } }
            false => Error { message: fail(c, "toml.unexpected-token") }
        }
    }

    fn parseBareValue(c) = {
        let b = TomlLexer::cur(c)
        if isDigit(b) { parseNumber(c) }
        else if b == bytePlus || b == byteMinus { match isDigit(TomlLexer::peek(c, 1)) {
            true => parseNumber(c)
            false => Error { message: fail(c, "toml.unexpected-token") }
        } }
        else if b >= 128 { Error { message: fail(c, "toml.non-ascii") } }
        else { Error { message: fail(c, "toml.unexpected-token") } }
    }

    fn parseBasicValue(c) = match TomlLexer::peek(c, 1) == byteQuote && TomlLexer::peek(c, 2) == byteQuote {
        true => Error { message: fail(c, "toml.unsupported-multiline-string") }
        false => match TomlLexer::basicString(c) {
            Success { value } => Success { value: Val { value: Str { text: value.text }, at: value.at } }
            Error { message } => Error { message: message }
        }
    }

    fn parseLiteralValue(c) = match TomlLexer::peek(c, 1) == byteApostrophe && TomlLexer::peek(c, 2) == byteApostrophe {
        true => Error { message: fail(c, "toml.unsupported-multiline-string") }
        false => match TomlLexer::literalString(c) {
            Success { value } => Success { value: Val { value: Str { text: value.text }, at: value.at } }
            Error { message } => Error { message: message }
        }
    }

    fn parseNumber(c) = match TomlLexer::scanBare(c) {
        Error { message } => Error { message: message }
        Success { value } => classifyNumber(value.token, value.at, c)
    }

    fn classifyNumber(token, after, start) = match intShape(token) {
        "" => match parseInt(stripUnderscores(token)) {
            Success { value } => intOk(value, after)
            Error => Error { message: fail(start, "toml.integer-range") }
        }
        _ => floatOrDatetime(token, start)
    }

    fn intOk(n, after) = Success { value: Val { value: Int { value: n }, at: after } }

    fn floatOrDatetime(token, start) = if hasByte(token, byteDot) || hasByte(token, 101) || hasByte(token, 69) {
        Error { message: fail(start, "toml.unsupported-float") }
    } else if hasByte(token, 58) || hasByte(token, 84) || hasByte(token, 90) || hasMinusAfterStart(token) {
        Error { message: fail(start, "toml.unsupported-datetime") }
    } else {
        Error { message: fail(start, "toml.bad-integer") }
    }

    fn intShape(token) = {
        let body = match startsWith(token, "+") || startsWith(token, "-") {
            true => drop(token, 1)
            false => token
        }
        match byteLength(body) == 0 {
            true => "toml.bad-integer"
            false => digitsShape(body)
        }
    }

    fn digitsShape(d) = match d == "0" {
        true => ""
        false => match isDigit1to9(byteAt(d, 0) ?: 0) {
            true => restDigits(d, 1)
            false => "toml.bad-integer"
        }
    }

    fn restDigits(d, i) = match i >= byteLength(d) {
        true => ""
        false => match isDigit(byteAt(d, i) ?: 0) {
            true => restDigits(d, i + 1)
            false => match (byteAt(d, i) ?: 0) == byteUnderscore {
                true => match isDigit(byteAt(d, i + 1) ?: -1) {
                    true => restDigits(d, i + 2)
                    false => "toml.bad-integer"
                }
                false => "toml.bad-integer"
            }
        }
    }

    // -- arrays -------------------------------------------------------------

    fn parseArray(c) = {
        let open = TomlLexer::advance(c)
        parseArrayItems(open, [], c)
    }

    fn parseArrayItems(c, items, start) = {
        let c1 = TomlLexer::skipTrivia(c)
        match TomlLexer::eof(c1) {
            true => Error { message: fail(start, "toml.unterminated-array") }
            false => match TomlLexer::cur(c1) == byteRBracket {
                true => Success { value: Val { value: Arr { items: items }, at: TomlLexer::advance(c1) } }
                false => match parseValue(c1) {
                    Error { message } => Error { message: message }
                    Success { value } => parseArrayNext(value.at, listAppend(items, value.value), start)
                }
            }
        }
    }

    fn parseArrayNext(c, items, start) = {
        let c1 = TomlLexer::skipTrivia(c)
        match TomlLexer::eof(c1) {
            true => Error { message: fail(start, "toml.unterminated-array") }
            false => match TomlLexer::cur(c1) == byteComma {
                true => parseArrayAfterComma(TomlLexer::advance(c1), items, start)
                false => match TomlLexer::cur(c1) == byteRBracket {
                    true => Success { value: Val { value: Arr { items: items }, at: TomlLexer::advance(c1) } }
                    false => Error { message: fail(c1, "toml.unexpected-token") }
                }
            }
        }
    }

    fn parseArrayAfterComma(c, items, start) = {
        let c1 = TomlLexer::skipTrivia(c)
        match TomlLexer::eof(c1) {
            true => Error { message: fail(start, "toml.unterminated-array") }
            false => match TomlLexer::cur(c1) == byteRBracket {
                true => Success { value: Val { value: Arr { items: items }, at: TomlLexer::advance(c1) } }
                false => parseArrayItems(c1, items, start)
            }
        }
    }

    // -- inline tables ------------------------------------------------------

    fn skipInlineSpaces(c) = skipInlineUpTo(c)
    fn skipInlineUpTo(c) = match TomlLexer::cur(c) == byteSpace || TomlLexer::cur(c) == byteTab {
        true => skipInlineUpTo(TomlLexer::advance(c))
        false => c
    }

    fn parseInlineTable(c) = {
        let open = TomlLexer::advance(c)
        parseInlineEntries(open, [], c)
    }

    fn parseInlineEntries(c, pairs, start) = {
        let c1 = skipInlineSpaces(c)
        match TomlLexer::cur(c1) == byteRBrace {
            true => Success { value: Val { value: Table { pairs: pairs }, at: TomlLexer::advance(c1) } }
            false => match TomlLexer::eof(c1) {
                true => Error { message: fail(start, "toml.unterminated-inline-table") }
                false => match TomlLexer::cur(c1) == byteNewline || TomlLexer::cur(c1) == byteCr {
                    true => Error { message: fail(c1, "toml.inline-table-newline") }
                    false => parseInlineEntry(c1, pairs, start)
                }
            }
        }
    }

    fn parseInlineEntry(c, pairs, start) = match parseKeySeg(c) {
        Error { message } => Error { message: message }
        Success { value } => inlineValue(value.seg, value.at, pairs, start)
    }

    fn inlineValue(seg, keyAt, pairs, start) = match expectEquals(keyAt) {
        Error { message } => Error { message: message }
        Success { value } => inlineEqValue(seg, value, pairs, start)
    }

    fn inlineEqValue(seg, eq, pairs, start) = match parseValue(skipInlineSpaces(eq)) {
        Error { message } => Error { message: message }
        Success { value } => inlineTail(seg, value, pairs, start)
    }

    fn inlineTail(seg, v, pairs, start) = match inlineAdd(pairs, seg, v.value) {
        Error { message } => Error { message: message }
        Success { value } => inlineAfterComma(v.at, value, start)
    }

    fn inlineAdd(pairs, seg, val) = match findPair(pairs, seg.name) >= 0 {
        true => Error { message: failSpan(seg.span, "toml.duplicate-key") }
        false => Success { value: listAppend(pairs, Pair { key: seg.name, value: val, span: seg.span }) }
    }

    fn inlineAfterComma(c, pairs, start) = {
        let c1 = skipInlineSpaces(c)
        match TomlLexer::cur(c1) == byteComma {
            true => inlineComma(TomlLexer::advance(c1), pairs, start)
            false => match TomlLexer::cur(c1) == byteRBrace {
                true => Success { value: Val { value: Table { pairs: pairs }, at: TomlLexer::advance(c1) } }
                false => inlineCloseError(c1, start)
            }
        }
    }

    fn inlineComma(c, pairs, start) = {
        let c1 = skipInlineSpaces(c)
        match TomlLexer::cur(c1) == byteRBrace {
            true => Error { message: fail(c1, "toml.inline-table-trailing-comma") }
            false => parseInlineEntries(c1, pairs, start)
        }
    }

    fn inlineCloseError(c, start) = match TomlLexer::cur(c) == byteNewline || TomlLexer::cur(c) == byteCr {
        true => Error { message: fail(c, "toml.inline-table-newline") }
        false => match TomlLexer::eof(c) {
            true => Error { message: fail(start, "toml.unterminated-inline-table") }
            false => Error { message: fail(c, "toml.unexpected-token") }
        }
    }

    // -- statements ---------------------------------------------------------

    fn expectEquals(c) = {
        let c1 = TomlLexer::skipSpaces(c)
        match TomlLexer::cur(c1) == byteEq {
            true => Success { value: TomlLexer::advance(c1) }
            false => Error { message: fail(c1, "toml.expected-equals") }
        }
    }

    fn expectClose(c) = {
        let c1 = TomlLexer::skipSpaces(c)
        match TomlLexer::cur(c1) == byteRBracket {
            true => Success { value: TomlLexer::advance(c1) }
            false => Error { message: fail(c1, "toml.unexpected-token") }
        }
    }

    fn expectDoubleClose(c) = {
        let c1 = TomlLexer::skipSpaces(c)
        match TomlLexer::cur(c1) == byteRBracket && TomlLexer::peek(c1, 1) == byteRBracket {
            true => Success { value: TomlLexer::advance(TomlLexer::advance(c1)) }
            false => Error { message: fail(c1, "toml.unexpected-token") }
        }
    }

    fn parseStatement(doc, c) = match TomlLexer::cur(c) == byteLBracket {
        true => parseHeader(doc, c)
        false => parseKeyValue(doc, c)
    }

    fn parseHeader(doc, c) = {
        let c1 = TomlLexer::advance(c)
        match TomlLexer::cur(c1) == byteLBracket {
            true => parseArrayHeader(doc, TomlLexer::advance(c1))
            false => parseTableHeader(doc, c1)
        }
    }

    fn parseTableHeader(doc, c) = match parseKeyPath(c) {
        Error { message } => Error { message: message }
        Success { value } => tableHeaderClose(doc, value)
    }

    fn tableHeaderClose(doc, path) = match expectClose(path.at) {
        Error { message } => Error { message: message }
        Success { value } => tableHeaderTail(doc, path, value)
    }

    fn tableHeaderTail(doc, path, close) = match TomlLexer::skipLineTail(close) {
        Error { message } => Error { message: message }
        Success { value } => tableHeaderDefine(doc, path, value)
    }

    fn tableHeaderDefine(doc, path, tail) = match defineTable(doc.root, path.segs) {
        Success { value } => Success { value: Step { doc: Doc { root: value, focus: Focus { keys: mapList(path.segs, fn(s) => s.name), index: noIndex } }, at: tail } }
        Error { message } => Error { message: message }
    }

    fn parseArrayHeader(doc, c) = match parseKeyPath(c) {
        Error { message } => Error { message: message }
        Success { value } => arrayHeaderClose(doc, value)
    }

    fn arrayHeaderClose(doc, path) = match expectDoubleClose(path.at) {
        Error { message } => Error { message: message }
        Success { value } => arrayHeaderTail(doc, path, value)
    }

    fn arrayHeaderTail(doc, path, close) = match TomlLexer::skipLineTail(close) {
        Error { message } => Error { message: message }
        Success { value } => arrayHeaderDefine(doc, path, value)
    }

    fn arrayHeaderDefine(doc, path, tail) = match defineArrayTable(doc.root, path.segs) {
        Success { value } => Success { value: Step { doc: Doc { root: value.root, focus: Focus { keys: mapList(path.segs, fn(s) => s.name), index: value.index } }, at: tail } }
        Error { message } => Error { message: message }
    }

    fn parseKeyValue(doc, c) = match parseKeyPath(c) {
        Error { message } => Error { message: message }
        Success { value } => kvEquals(doc, value)
    }

    fn kvEquals(doc, path) = match expectEquals(path.at) {
        Error { message } => Error { message: message }
        Success { value } => kvValue(doc, path, value)
    }

    fn kvValue(doc, path, eq) = {
        let c1 = TomlLexer::skipSpaces(eq)
        match missingValueAt(c1) {
            true => Error { message: fail(c1, "toml.expected-value") }
            false => match parseValue(c1) {
                Error { message } => Error { message: message }
                Success { value } => kvTail(doc, path, value)
            }
        }
    }

    fn kvTail(doc, path, v) = match TomlLexer::skipLineTail(v.at) {
        Error { message } => Error { message: message }
        Success { value } => kvInsert(doc, path, v.value, value)
    }

    fn kvInsert(doc, path, val, tail) = match insertAtFocus(doc, path.segs, val) {
        Success { value } => Success { value: Step { doc: value, at: tail } }
        Error { message } => Error { message: message }
    }

    fn parseDocument(doc, c) = {
        let c1 = TomlLexer::skipTrivia(c)
        match TomlLexer::eof(c1) {
            true => Success { value: doc.root }
            false => match parseStatement(doc, c1) {
                Success { value } => parseDocument(value.doc, value.at)
                Error { message } => Error { message: message }
            }
        }
    }

    // -- public API ---------------------------------------------------------

    let initialFocus = Focus { keys: [], index: noIndex }

    /// Parse a TOML document into its root table, or the first problem.
    export fn parse(text) -> Result<Value, Problem> = parseDocument(Doc { root: emptyTable, focus: initialFocus }, TomlLexer::start(text))

    /// The value stored under `key`, or a stable reason code.
    export fn get(table, key) = match table {
        Table { pairs } => match findPair(pairs, key) >= 0 {
            true => Success { value: pairAt(pairs, findPair(pairs, key)).value }
            false => Error { message: "toml.missing-key" }
        }
        _ => Error { message: "toml.not-a-table" }
    }

    /// The keys of a table in document order.
    export fn keys(table) = match table {
        Table { pairs } => mapList(pairs, fn(p) => p.key)
        _ => []
    }

    /// A one-line diagnostic `code at line:column`.
    export fn describe(problem) = "${problem.code} at ${problem.line}:${problem.column}"
}
