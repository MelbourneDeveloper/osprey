namespace osprey_pkg;
import registry::Policy
import registry_host::Host
import registry_host::Native
import registry_cli::Dispatch

/// Osprey has no argv builtin yet (`process.argv` in `Capabilities`), so the
/// frontend reads one command line from standard input:
/// `echo "doctor" | osprey-pkg`. The exit status is reported on the last line
/// because `process.exit-status` is blocked too.
fn arguments() = words(input())

fn emit(report) = {
    forEachList(report.lines, fn(text) => perform Host::Console.line(text))
    report.status
}

fn session() = Native::session(fn() => emit(Dispatch::run(arguments())))

fn main() = print("status: ${Policy::guarded(session)}")
