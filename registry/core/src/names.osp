namespace registry;

/// Canonical package keys `@scope/name`. Components are lowercase ASCII
/// letters, digits and interior hyphens; a scope is 1-39 bytes and a name is
/// 1-63. Unicode display names never resolve and unscoped names are invalid.
/// Failures are stable reason codes, never prose. Implements [PACKAGE-NAMES].
module Names {
    export type Key = { scope: string, name: string }

    let scopeMax = 39
    let nameMax = 63
    let hyphen = 45

    fn lowerAlnum(b) = (b >= 97 && b <= 122) || (b >= 48 && b <= 57)
    fn byteOk(b) = lowerAlnum(b) || b == hyphen
    fn bytesOk(s) = fold(range(0, byteLength(s)), true, fn(ok, i) => ok && byteOk(byteAt(s, i) ?: 0))
    fn interiorHyphens(s) = !startsWith(s, "-") && !endsWith(s, "-")

    /// One component against its length ceiling; `""` means valid.
    fn component(s, max, code) = match byteLength(s) >= 1 && byteLength(s) <= max {
        false => "${code}.length"
        true => match bytesOk(s) && interiorHyphens(s) {
            true => ""
            false => "${code}.chars"
        }
    }

    fn split(body) = match indexOf(body, "/") {
        Success { value } => Success { value: Key { scope: take(body, value), name: drop(body, value + 1) } }
        Error => Error { message: "name.unscoped-or-missing-slash" }
    }

    fn validate(key) = match contains(key.name, "/") {
        true => Error { message: "name.extra-slash" }
        false => match component(key.scope, scopeMax, "name.scope") + component(key.name, nameMax, "name.name") {
            "" => Success { value: key }
            code => Error { message: code }
        }
    }

    /// Parse a display key such as `@finch/ledger` into its canonical parts.
    export fn parse(text) = match startsWith(text, "@") {
        false => Error { message: "name.missing-at" }
        true => match split(drop(text, 1)) {
            Success { value } => validate(value)
            Error { message } => Error { message: message }
        }
    }

    /// The display form `@scope/name`.
    export fn display(key) = "@${key.scope}/${key.name}"

    /// Canonical `(scope, name)` byte order: negative, zero or positive.
    export fn compare(a, b) = match a.scope == b.scope {
        true => Order::compareStrings(a.name, b.name)
        false => Order::compareStrings(a.scope, b.scope)
    }
}
