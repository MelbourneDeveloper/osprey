namespace registry_tests;
import registry::Bundle
import registry::Catalog
import registry_api::Router
import registry_tests::CatalogTests

/// The pure routing function: every route, every problem code and status,
/// ETags, method rejection, query-string stripping and the optional "@".
/// Implements the endpoints of [PACKAGE-FOLDER-REGISTRY] and [PACKAGE-API].
module RouterTests {
    fn respond(method, path) = Router::respond(CatalogTests::fixture(), method, path)

    fn healthRoute() = {
        let r = respond("GET", "/v1/health")
        checkAll("router: health route", [
            r.status == 200,
            r.contentType == "application/json",
            r.etag == "",
            r.body == "{\"refused\":1,\"releases\":3,\"status\":\"ok\"}"
        ])
    }

    fn packagesRoute() = {
        let r = respond("GET", "/v1/packages")
        checkAll("router: packages route", [
            r.status == 200,
            r.contentType == "application/json",
            r.etag == "",
            r.body == (Catalog::packagesJson(CatalogTests::fixture()) ?: "?")
        ])
    }

    fn packageRoute() = {
        let withAt = respond("GET", "/v1/packages/@finch/util")
        let bare = respond("GET", "/v1/packages/finch/util")
        let missing = respond("GET", "/v1/packages/finch/gone")
        checkAll("router: package route, \"@\" optional", [
            withAt.status == 200,
            withAt.body == bare.body,
            withAt.body == "{\"key\":\"@finch/util\",\"releases\":[{\"digest\":\"${CatalogTests::digestC()}\",\"epoch\":1,\"ordinal\":1}]}",
            missing.status == 404,
            missing.contentType == "application/problem+json",
            missing.body == "{\"code\":\"catalog.unknown-package\",\"status\":404,\"title\":\"Unknown package\"}"
        ])
    }

    fn releaseRoute() = {
        let r = respond("GET", "/v1/releases/${CatalogTests::digestA()}")
        let missing = respond("GET", "/v1/releases/sha256:zz")
        checkAll("router: release route", [
            r.status == 200,
            r.etag == "\"${CatalogTests::digestA()}\"",
            r.body == "{\"digest\":\"${CatalogTests::digestA()}\",\"epoch\":1,\"files\":[\"osprey.toml\",\"src/lib.osp\"],\"key\":\"@finch/ledger\",\"ordinal\":1}",
            missing.status == 404,
            missing.etag == "",
            missing.body == "{\"code\":\"catalog.unknown-release\",\"status\":404,\"title\":\"Unknown release\"}"
        ])
    }

    fn sourceRoute() = {
        let r = respond("GET", "/v1/releases/${CatalogTests::digestA()}/source")
        let missing = respond("GET", "/v1/releases/sha256:zz/source")
        checkAll("router: source route", [
            r.status == 200,
            r.contentType == "application/json",
            r.etag == "\"${CatalogTests::digestA()}\"",
            r.body == (Bundle::encode(CatalogTests::ledgerEarly()) ?: "?"),
            missing.status == 404,
            missing.body == "{\"code\":\"catalog.unknown-release\",\"status\":404,\"title\":\"Unknown release\"}"
        ])
    }

    fn methodRejection() = {
        let r = respond("POST", "/v1/health")
        checkAll("router: non-GET rejected", [
            r.status == 405,
            r.contentType == "application/problem+json",
            r.etag == "",
            r.body == "{\"code\":\"api.method-not-allowed\",\"status\":405,\"title\":\"Method not allowed\"}"
        ])
    }

    fn queryStrings() = checkAll("router: query strings ignored", [
        respond("GET", "/v1/packages?cursor=2").status == 200,
        respond("GET", "/v1/packages?cursor=2").body == respond("GET", "/v1/packages").body,
        respond("GET", "/v1/health?x=1").body == respond("GET", "/v1/health").body
    ])

    fn unknownRoutes() = {
        let r = respond("GET", "/v1/nope")
        checkAll("router: unknown routes 404", [
            r.status == 404,
            r.contentType == "application/problem+json",
            r.body == "{\"code\":\"api.not-found\",\"status\":404,\"title\":\"Not found\"}",
            respond("GET", "/").status == 404,
            respond("GET", "/v1/packages/a/b/c").status == 404,
            respond("GET", "/v1/releases/x/other").status == 404,
            respond("GET", "/v1/health/extra").status == 404
        ])
    }

    export fn run() = {
        test("router: health route", healthRoute)
        test("router: packages route", packagesRoute)
        test("router: package route", packageRoute)
        test("router: release route", releaseRoute)
        test("router: source route", sourceRoute)
        test("router: non-GET rejected", methodRejection)
        test("router: query strings ignored", queryStrings)
        test("router: unknown routes 404", unknownRoutes)
    }
}
