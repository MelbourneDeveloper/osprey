/// [BUILTIN-LIST-MAP], [BUILTIN-LIST-FILTER] and [BUILTIN-LIST-FOLD] traverse a
/// runtime list eagerly in index order; [BUILTIN-LIST-SORT] returns a new list
/// sorted ascending by the elements' natural order.

fn double(n) = satMul(n, 2)

fn weave(acc, value) = satAdd(satMul(acc, 10), value)

fn upper(word) = toUpperCase(word)

/// mapList/filterList/foldList over a list built with listAppend (a runtime
/// handle) and over a flat literal (rebuilt at the call boundary).
fn eagerCombinatorsCase() = {
    let ints = listAppend(listAppend(listAppend(List(), 3), 1), 2)
    let words = ["beta", "alpha", "gamma"]

    checkAll("mapList transforms each element in index order", [
        (listGet(mapList(ints, double), 0) ?: 0) == 6,
        (listGet(mapList(ints, double), 1) ?: 0) == 2,
        (listGet(mapList(ints, double), 2) ?: 0) == 4,
        listLength(mapList(ints, double)) == 3,
        join(mapList(words, upper), ",") == "BETA,ALPHA,GAMMA",
        join(mapList(["a", "b"], upper), ",") == "A,B"
    ])

    checkAll("filterList keeps matching elements in index order", [
        join(filterList(words, fn(word) => word != "beta"), ",") == "alpha,gamma",
        listLength(filterList(ints, fn(n) => n > 1)) == 2,
        (listGet(filterList(ints, fn(n) => n > 1), 0) ?: 0) == 3,
        (listGet(filterList(ints, fn(n) => n > 1), 1) ?: 0) == 2,
        join(filterList(["a", "b", "c"], fn(w) => w != "b"), ",") == "a,c"
    ])

    checkAll("foldList reduces in index order", [
        foldList(ints, 0, weave) == 312,
        foldList(words, "", fn(acc, word) => acc + word) == "betaalphagamma",
        foldList([1, 2, 3], 0, weave) == 123
    ])
}

/// listSort is ascending and total for int and string lists; a float, bool or
/// record element is rejected by the type checker ([BUILTIN-LIST-SORT]).
fn sortCase() = {
    let ints = listSort([3, 1, 2])
    let words = listSort(["beta", "alpha", "gamma"])

    checkAll("listSort orders int lists ascending", [
        listLength(ints) == 3,
        (listGet(ints, 0) ?: 0) == 1,
        (listGet(ints, 1) ?: 0) == 2,
        (listGet(ints, 2) ?: 0) == 3,
        (listGet(listSort([-1, 5, 0]), 0) ?: 0) == -1,
        (listGet(listSort([-1, 5, 0]), 1) ?: 0) == 0,
        (listGet(listSort([-1, 5, 0]), 2) ?: 0) == 5,
        (listGet(listSort(listAppend(listAppend(listAppend(List(), 30), 10), 20)), 0) ?: 0) == 10,
        (listGet(listSort(listAppend(listAppend(listAppend(List(), 30), 10), 20)), 2) ?: 0) == 30,
        listLength(listSort([7])) == 1,
        listLength(listSort(List())) == 0
    ])

    checkAll("listSort orders string lists ascending", [
        join(words, ",") == "alpha,beta,gamma",
        join(listSort(["z", "a", "m"]), ",") == "a,m,z",
        join(listSort([""]), ",") == "",
        join(listSort(["same", "same"]), ",") == "same,same"
    ])
}

test("list map/filter/fold traverse eagerly", fn() => eagerCombinatorsCase())
test("listSort orders int and string lists ascending", fn() => sortCase())
